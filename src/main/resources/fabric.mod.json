{
	"schemaVersion": 1,
	"id": "mcci_orange_text",
	"version": "${version}",
	"name": "MCCI Orange Text Features",
	"description": "A mod that allows you to automate orange text in MCC Island",
	"authors": [
		"Mushroomified"
	],
	"contact": {
		"sources": "https://github.com/Mushroomified/mcci_orange_text",
		"issues": "https://github.com/Mushroomified/mcci_orange_text/issues"
	},
	"license": "MIT",
	"icon": "assets/mcci_orange_text/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"mushroomified.mcci_orange_text.MCCI_orange_text"
		],
		"client": [
			"mushroomified.mcci_orange_text.client.HotKeys"
		],
		"modmenu": [
			"mushroomified.mcci_orange_text.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"mcci_orange_text.mixins.json",
		{
			"config": "mcci_orange_text.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": "*"
	}
}